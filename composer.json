{
  "name": "vitalrix/vitalrix",
  "description": "Send traces, metrics and logs from PHP to VitalRix in one call (OpenTelemetry under the hood).",
  "type": "library",
  "license": "MIT",
  "keywords": ["observability", "opentelemetry", "apm", "tracing", "logging", "monitoring"],
  "homepage": "https://vitalrix.com",
  "support": { "source": "https://github.com/avinashManiTripathi/vitalrix-sdks", "docs": "https://docs.vitalrix.com/apm/setup" },
  "require": {
    "php": ">=8.1",
    "open-telemetry/sdk": "^1.0",
    "open-telemetry/exporter-otlp": "^1.0",
    "google/protobuf": "^3.22 || ^4.0",
    "guzzlehttp/guzzle": "^7.8",
    "guzzlehttp/psr7": "^2.6"
  },
  "require-dev": { "phpunit/phpunit": "^10.5 || ^11.0" },
  "autoload": { "psr-4": { "Vitalrix\\": "php/src/" } },
  "autoload-dev": { "psr-4": { "Vitalrix\\Tests\\": "php/tests/" } },
  "bin": ["php/bin/vitalrix"],
  "config": { "allow-plugins": { "php-http/discovery": true, "tbachert/spi": true } }
}
