#!/usr/bin/env php
<?php
// `vitalrix check`: sends one test log so you know the key and URL work.
// Composer sets $_composer_autoload_path for installed bins; the others: this repo, then vendor/vitalrix/vitalrix/php/bin.
foreach ([$GLOBALS['_composer_autoload_path'] ?? '', __DIR__ . '/../../vendor/autoload.php', __DIR__ . '/../../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) { require $autoload; break; }
}
if (($argv[1] ?? '') !== 'check') {
    fwrite(STDERR, "usage: vitalrix check\n");
    exit(2);
}
try {
    echo \Vitalrix\Vitalrix::check(), "\n";
} catch (\Throwable $e) {
    fwrite(STDERR, 'vitalrix: ' . $e->getMessage() . "\n");
    exit(1);
}
